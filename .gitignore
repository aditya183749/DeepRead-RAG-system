# Python environments
venv/
env/
.env
__pycache__/
*.pyc
*.pyo

# IDEs and Tools
.vscode/
.idea/
.DS_Store

# Data, Logs, and App Storage
storage/logs/*.jsonl
storage/uploads/*

# Binary indexes (regenerated on first upload — do not commit)
storage/faiss/*.index
storage/faiss/*.pkl
storage/bm25/*.pkl

# SQLite database (user session data — do not commit)
storage/sessions.db

# Ignore sensitive reports
*.docx
tl_progress_report.md
